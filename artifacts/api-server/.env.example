# APP_DATA_MODE defaults to fixture so the UI can be demonstrated without n8n.
APP_DATA_MODE=fixture
QUESTION_MAX_LENGTH=2000

# These must be set as server-side Replit Secrets/configuration for live mode.
# N8N_WEBHOOK_URL is the research endpoint; never reuse the connection-test URL.
N8N_WEBHOOK_URL=
N8N_CONNECTION_TEST_URL=
N8N_AUTH_HEADER_NAME=X-GlobalEdge-Key
N8N_AUTH_HEADER_VALUE=
N8N_TIMEOUT_MS=60000
